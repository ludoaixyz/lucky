{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lucky.local/schemas/game-config.schema.json",
  "title": "Lucky game source configuration",
  "type": "object",
  "required": [
    "schemaVersion",
    "gameId",
    "gameVersion",
    "configurationId",
    "reelCount",
    "visibleRows",
    "lineBetCredits",
    "totalBetCredits",
    "maximumWinCredits"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "gameId": { "type": "string", "minLength": 1 },
    "gameVersion": { "type": "string", "minLength": 1 },
    "configurationId": { "type": "string", "minLength": 1 },
    "reelCount": { "type": "integer", "minimum": 1 },
    "visibleRows": { "type": "integer", "minimum": 1 },
    "lineBetCredits": { "type": "integer", "minimum": 1 },
    "totalBetCredits": { "type": "integer", "minimum": 1 },
    "maximumWinCredits": { "type": "integer", "minimum": 0 }
  },
  "additionalProperties": true
}

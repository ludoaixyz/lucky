{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lucky.local/schemas/game-config.schema.json",
  "title": "LUCKY888 game source configuration",
  "type": "object",
  "required": [
    "schemaVersion",
    "gameId",
    "gameName",
    "gameVersion",
    "configurationId",
    "selectedRtpProfile",
    "payModel",
    "reelCount",
    "visibleRows",
    "lineBetCredits",
    "totalBetCredits",
    "maximumWinCredits",
    "maximumWinScope",
    "rtpBudgets"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "gameId": { "const": "lucky888" },
    "gameName": { "const": "LUCKY888" },
    "gameVersion": { "type": "string", "minLength": 1 },
    "configurationId": { "type": "string", "minLength": 1 },
    "selectedRtpProfile": { "const": "lucky888-production-20line-v1" },
    "payModel": { "const": "fixed-paylines-left-to-right" },
    "reelCount": { "type": "integer", "minimum": 1 },
    "visibleRows": { "type": "integer", "minimum": 1 },
    "lineBetCredits": { "type": "number", "exclusiveMinimum": 0 },
    "totalBetCredits": { "type": "integer", "minimum": 1 },
    "maximumWinCredits": { "type": "integer", "minimum": 1 },
    "maximumWinScope": { "const": "paid-spin-including-feature" },
    "rtpBudgets": {
      "type": "object",
      "required": [
        "provisional",
        "initialBoardBaseLine",
        "cascadeStages",
        "freeSpinFeature",
        "scatterDirectPay",
        "creditedTotal"
      ],
      "properties": {
        "provisional": { "const": true },
        "initialBoardBaseLine": { "$ref": "#/$defs/range" },
        "cascadeStages": { "$ref": "#/$defs/range" },
        "freeSpinFeature": { "$ref": "#/$defs/range" },
        "scatterDirectPay": { "$ref": "#/$defs/range" },
        "creditedTotal": { "$ref": "#/$defs/range" },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },
    "cascades": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "scatterEvaluation": { "const": "initial-grid-only" },
        "maximumCascadesPerSpin": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "volatilityTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "provisional", "standardDeviationMultiple", "tailTargets"],
      "properties": {
        "classification": { "enum": ["low", "medium", "medium-high", "high"] },
        "provisional": { "const": true },
        "standardDeviationMultiple": { "$ref": "#/$defs/range" },
        "tailTargets": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "20xPlusProbability",
            "50xPlusProbability",
            "100xPlusProbability",
            "250xPlusProbability"
          ],
          "properties": {
            "20xPlusProbability": { "$ref": "#/$defs/probabilityRange" },
            "50xPlusProbability": { "$ref": "#/$defs/probabilityRange" },
            "100xPlusProbability": { "$ref": "#/$defs/probabilityRange" },
            "250xPlusProbability": { "$ref": "#/$defs/probabilityRange" }
          }
        },
        "notes": { "type": "string" }
      }
    },
    "featureFrequencyTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paidSpinsPerTrigger", "provisional"],
      "properties": {
        "provisional": { "const": true },
        "paidSpinsPerTrigger": {
          "type": "object",
          "additionalProperties": false,
          "required": ["target", "minimum", "maximum"],
          "properties": {
            "target": { "type": "number", "exclusiveMinimum": 0 },
            "minimum": { "type": "number", "exclusiveMinimum": 0 },
            "maximum": { "type": "number", "exclusiveMinimum": 0 }
          }
        }
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "range": {
      "type": "object",
      "required": ["minimum", "maximum"],
      "properties": {
        "minimum": { "type": "number", "minimum": 0 },
        "maximum": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "probabilityRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum", "maximum"],
      "properties": {
        "minimum": { "type": "number", "minimum": 0, "maximum": 1 },
        "maximum": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lucky.local/schemas/simulation-report.schema.json",
  "title": "Lucky simulation report",
  "type": "object",
  "required": [
    "schemaVersion",
    "gameVersion",
    "configurationId",
    "generatedAt",
    "seed",
    "spinCount",
    "totalWagerCredits",
    "totalPayoutCredits",
    "winningSpinCount",
    "featureTriggerCount",
    "rtp",
    "hitFrequency",
    "bonusFrequency",
    "variance",
    "standardDeviation",
    "rtpConfidence95",
    "payoutDistribution"
  ],
  "properties": {
    "spinCount": { "type": "integer", "minimum": 1 },
    "totalWagerCredits": { "type": "integer", "minimum": 0 },
    "totalPayoutCredits": { "type": "integer", "minimum": 0 },
    "rtp": { "type": "number", "minimum": 0 },
    "hitFrequency": { "type": "number", "minimum": 0, "maximum": 1 },
    "bonusFrequency": { "type": "number", "minimum": 0, "maximum": 1 }
  },
  "additionalProperties": true
}

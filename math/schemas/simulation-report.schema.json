{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lucky888.local/schemas/bathala-simulation-report-2.0.0.json",
  "title": "Lucky888 Bathala Simulation Report 2.x",
  "type": "object",
  "required": ["metadata", "simulation", "metrics"],
  "properties": {
    "metadata": {
      "type": "object",
      "required": [
        "schemaVersion",
        "gameId",
        "gameName",
        "gameVersion",
        "configurationId",
        "generatedAt"
      ],
      "properties": {
        "schemaVersion": { "type": "string", "pattern": "^2\\.[0-9]+\\.[0-9]+$" },
        "gameId": { "const": "lucky888" },
        "gameName": { "type": "string", "minLength": 1 },
        "gameVersion": { "type": "string", "minLength": 1 },
        "configurationId": { "type": "string", "minLength": 1 },
        "generatedAt": { "type": "string", "format": "date-time" },
        "calibrationProfile": { "type": "string" }
      },
      "additionalProperties": false
    },
    "simulation": {
      "type": "object",
      "required": ["methodology", "seed", "spins"],
      "properties": {
        "methodology": { "const": "deterministic-streaming-monte-carlo" },
        "seed": { "type": "integer", "minimum": 0 },
        "spins": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "metrics": {
      "type": "object",
      "required": [
        "totalSpins",
        "totalBet",
        "totalCreditedWin",
        "rtp",
        "winningSpinFrequency",
        "components",
        "tails",
        "variance",
        "standardDeviation",
        "standardError",
        "confidenceInterval95"
      ],
      "properties": {
        "totalSpins": { "type": "integer", "minimum": 1 },
        "totalBet": { "type": "number", "minimum": 0 },
        "totalCreditedWin": { "type": "number", "minimum": 0 },
        "rtp": { "type": "number", "minimum": 0, "maximum": 1 },
        "winningSpinFrequency": { "type": "number", "minimum": 0, "maximum": 1 },
        "variance": { "type": "number", "minimum": 0 },
        "standardDeviation": { "type": "number", "minimum": 0 },
        "standardError": { "type": "number", "minimum": 0 },
        "confidenceInterval95": {
          "type": "array",
          "prefixItems": [
            { "type": "number", "minimum": 0 },
            { "type": "number", "minimum": 0 }
          ],
          "minItems": 2,
          "maxItems": 2
        },
        "components": {
          "type": "object",
          "required": [
            "baseGameRegularPayout",
            "baseGameScatterPayout",
            "baseGameMultiplierUplift",
            "freeGameRegularPayout",
            "freeGameScatterPayout",
            "freeGameMultiplierUplift"
          ],
          "additionalProperties": { "type": "number", "minimum": 0 }
        },
        "tails": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["threshold", "count", "frequency"],
            "properties": {
              "threshold": { "type": "number", "exclusiveMinimum": 0 },
              "count": { "type": "integer", "minimum": 0 },
              "frequency": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lucky.local/schemas/simulation-report.schema.json",
  "title": "Lucky888 feature-inclusive simulation report",
  "type": "object",
  "required": [
    "paidSpins",
    "totalWageredCredits",
    "basePayoutCredits",
    "featurePayoutCredits",
    "totalPayoutCredits",
    "baseRtp",
    "featureRtp",
    "totalRtp",
    "baseHitFrequency",
    "featureTriggerFrequency",
    "featureInclusiveHitFrequency",
    "variance",
    "standardDeviation",
    "standardError",
    "confidenceInterval95",
    "maximumObservedWinCredits",
    "capApplications",
    "payoutDistribution"
  ],
  "properties": {
    "paidSpins": { "type": "integer", "minimum": 1 },
    "totalWageredCredits": { "type": "integer", "minimum": 0 },
    "basePayoutCredits": { "type": "integer", "minimum": 0 },
    "featurePayoutCredits": { "type": "integer", "minimum": 0 },
    "totalPayoutCredits": { "type": "integer", "minimum": 0 },
    "baseRtp": { "type": "number", "minimum": 0 },
    "featureRtp": { "type": "number", "minimum": 0 },
    "totalRtp": { "type": "number", "minimum": 0 },
    "featureTriggerFrequency": { "type": "number", "minimum": 0, "maximum": 1 },
    "confidenceInterval95": {
      "type": "array",
      "prefixItems": [{ "type": "number" }, { "type": "number" }],
      "minItems": 2,
      "maxItems": 2
    }
  },
  "additionalProperties": true
}
